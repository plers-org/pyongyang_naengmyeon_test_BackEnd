[Unit]
Description=plers recommendation API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/services/src/app
EnvironmentFile=/home/ubuntu/services/.env
ExecStart=/home/ubuntu/services/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
